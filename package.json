{
  "description": "An audio equalizer app",
  "keywords": [
    "electron",
    "boilerplate",
    "react",
    "typescript",
    "ts",
    "sass",
    "webpack",
    "hot",
    "reload"
  ],
  "homepage": "https://github.com/AndreiShenets/AQUA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreiShenets/AQUA.git"
  },
  "license": "GPLv3",
  "author": {
    "name": "JATY"
  },
  "main": "./src/main/main.ts",
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "cross-env NODE_ENV=production node --import tsx ./node_modules/webpack-cli/bin/cli.js --disable-interpret --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production node --import tsx ./node_modules/webpack-cli/bin/cli.js --disable-interpret --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "postinstall": "tsx .erb/scripts/check-native-dep.js && electron-builder install-app-deps && npm run install:chromedriver && npm run build:dll",
    "install:chromedriver": "node .erb/scripts/install-chromedriver.mjs",
    "build:dll": "cross-env NODE_ENV=development node --import tsx ./node_modules/webpack-cli/bin/cli.js --disable-interpret --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "package": "tsx ./.erb/scripts/clean.js dist && npm run typecheck && npm run build && electron-builder build --publish never",
    "prepare": "husky",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "tsx ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "cross-env NODE_ENV=development electronmon --import tsx .",
    "start:preload": "cross-env NODE_ENV=development node --import tsx ./node_modules/webpack-cli/bin/cli.js --disable-interpret --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development node --import tsx ./node_modules/webpack-cli/bin/cli.js serve --disable-interpret --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "jest",
    "test:unit": "jest --testMatch **/__tests__/unit_tests/**/*.ts?(x)",
    "test:cucumber": "jest --testMatch **/__tests__/cucumber_tests/*.ts?(x) --runInBand",
    "test:smoke": "node .erb/scripts/smoke-test.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ]
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "src",
      "node_modules",
      "release/app/node_modules"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      "d3": "<rootDir>/node_modules/d3/dist/d3.min.js"
    },
    "setupFiles": [
      "./src/__tests__/utils/setup.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "tsx": true
            },
            "target": "es2022",
            "transform": {
              "react": {
                "runtime": "automatic"
              }
            }
          }
        }
      ]
    },
    "testMatch": [
      "**/__tests__/*_tests/**/*.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid)/)",
      "\\.pnp\\.[^\\/]+$"
    ]
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "d3": "^7.9.0",
    "electron-debug": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "regedit": "^5.1.4",
    "source-map-support": "^0.5.21",
    "uid": "^2.0.2"
  },
  "devDependencies": {
    "@electron/get": "^5.0.0",
    "@electron-internal/extract-zip": "^1.0.8",
    "@electron/notarize": "^3.1.2",
    "@electron/rebuild": "^4.2.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "chalk": "^6.0.1",
    "concurrently": "^10.0.6",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electronmon": "^2.0.4",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-cucumber": "^4.5.0",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "node-gyp": "^13.1.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "react-refresh": "^0.19.0",
    "rimraf": "^6.1.3",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webdriverio": "^10.1.0",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "build": {
    "productName": "AQUA",
    "appId": "org.jaty.AQUA",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "runAfterFinish": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**",
      {
        "from": "node_modules/regedit/vbs",
        "to": "vbs",
        "filter": [
          "**/*"
        ]
      },
      "./autoeq/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "AndreiShenets",
      "repo": "AQUA"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/*"
    ],
    "logLevel": "quiet"
  },
  "allowScripts": {
    "@swc/core@1.16.21": true,
    "esbuild@0.28.2": true
  }
}
